# Скопируйте этот файл в .env и заполните своими данными Telegram API.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_SESSION=broadcast_session
# Путь к файлу с хешами одноразовых ключей.
BROADCAST_KEYS_FILE=keys.txt
# Путь, где хранится подтвержденный хеш (чтобы не вводить ключ повторно).
# BROADCAST_KEYS_CACHE=keys.txt.accepted
# Опционально можно передать ключ через переменную окружения, но безопаснее вводить его вручную.
# ACCESS_KEY=
